# ─────────────────────────────────────────────────────────────────────────────
# SARA — environment configuration
# Copy to `.env` in this folder. The server, the seed/eval scripts, Vite
# (VITE_* only) and docker-compose all read this one file.
# Text after " #" is a comment: wrap any value that contains "#" in quotes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5080                          # API port; Vite's dev proxy reads it too (5055 is used by Docker Desktop on some machines)
CLIENT_URL=http://localhost:5173   # CORS origin for the web app (comma-separate several); in Docker the public web address
WEB_PORT=80                        # docker-compose.yml only: host port of the web app (nginx; /api is proxied to the server)
LOG_LEVEL=info                     # fatal | error | warn | info | debug | trace
LOG_PROMPTS=false                  # true = log full Gemini prompts at debug level

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Must name the database. Replica sets / Atlas work too: mongodb://<host>:27017/sara?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017/sara
# Tests create and drop <SARA_TEST_DB>_<n> databases here (default sara_test_<n>; the path is ignored, ?options
# are kept). On a shared or remote server run tests with SARA_TEST_DB=<unique label> so no real database matches.
MONGO_TEST_URI=mongodb://localhost:27017
# Shell-only, not read from this file: SARA_TEST_DB=<label> (test database prefix, default sara_test) and
# SARA_EVAL_DB=<name> (database `pnpm eval` creates on MONGO_TEST_URI, default sara_eval). Never use sara,
# admin, local, config or the name of any real database: the tests drop what they create.

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_LIFETIME=1d
SESSION_TTL_HOURS=24
SUPERADMIN_EMAIL=superadmin@swayatt.com     # created by `pnpm seed` (and on first server start)
# Only used when the superadmin is first created: to change it later, change it in the app (or
# `pnpm seed --reset`). Pick a strong one; it is never shown anywhere.
SUPERADMIN_PASSWORD=Admin@SARA-2026

# ── InfluxDB 2.x ─────────────────────────────────────────────────────────────
# The telemetry source writes the same InfluxDB (one bucket per company, named by its id); SARA reads it.
INFLUX_URL=http://localhost:8086
# INFLUX_URL, INFLUX_TOKEN and INFLUX_ORG must match the telemetry source's .env. SARA reads; tests also write
# and create and delete throwaway buckets (all-access token in dev).
INFLUX_TOKEN=sara-dev-token
INFLUX_ORG=sara
INFLUX_ADMIN_USER=sara             # docker-compose.dev.yml first-run setup only (local dev databases)
INFLUX_ADMIN_PASSWORD=sara-admin-pass

# ── Google Gemini ────────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey. Free-tier quotas are small and
# per model; a billing-enabled key is recommended for demo day.
GEMINI_API_KEY=
# AI_MOCK=true (or an empty GEMINI_API_KEY) swaps Gemini for scripted responses for development: 0 Gemini
# calls, no cost. The engines still run on the real data, so plans, costs, KPIs, anomaly features and
# briefings are real numbers; only the AI's words and judgements are scripted (server/src/ai/mock*.js). The
# scripted anomaly judge flags |z| >= 3 on two fields (>= 5 on one), flatlines, idle power and rejects; chat
# drives the real tools for the flows it lists when you say "hi" (planning, maintenance windows, CRUD, cost
# alerts, KPIs, machine questions), with the same Confirm cards. Provenance lines then read "<model> (mock)".
# AI_MOCK=false with a key = real Gemini: chat AND the background jobs (anomaly scans, investigations, cost
# texts, KPI insights, briefings) spend quota. Restart the server after changing it (.env is not watched).
# Tests and `pnpm eval` always use the scripted responses.
AI_MOCK=false
# Initial tier models (all free tier, checked 2026-10-15). Superadmin → AI changes them live.
GEMINI_MODEL_ROUTER=gemini-3.1-flash-lite
GEMINI_MODEL_FAST=gemini-3.6-flash
GEMINI_MODEL_BALANCED=gemini-3.8-flash
GEMINI_MODEL_DEEP=gemini-3.8-flash
GEMINI_MODEL_BACKGROUND=gemini-3.5-flash-lite
GEMINI_FALLBACK_FAST=gemini-3.8-flash
GEMINI_FALLBACK_BALANCED=gemini-3.6-flash
GEMINI_FALLBACK_DEEP=gemini-3.6-flash
# Voice assistant (Gemini Live, native audio). Ids not verified yet: Superadmin → AI → Voice lists the models your
# key can use for Live (bidiGenerateContent) and changes them live.
GEMINI_MODEL_VOICE=gemini-3.1-flash-live-preview
GEMINI_FALLBACK_VOICE=gemini-2.5-flash-native-audio-preview-12-2025

# ── AI agent limits ──────────────────────────────────────────────────────────
MAX_ROWS=200                       # max rows a read tool returns
MAX_TOOL_ITERATIONS=6              # model ↔ tool round trips per chat turn
MAX_TURN_MS=90000
TOOL_TIMEOUT_MS=20000
HISTORY_TURNS=12
PENDING_ACTION_TTL_MIN=10          # how long a Confirm card stays valid
ENABLE_RAW_FLUX=false              # expose the validated raw-Flux tool to the agent
DEFAULT_TIMEZONE=Asia/Kolkata      # used when a company has no time zone

# ── Background AI (initial values; editable in Superadmin → AI) ──────────────
ANOMALY_SCAN_TICK_SEC=60           # how often flagged assets are reviewed by Gemini
ANOMALY_QUIET_INTERVAL_MIN=10      # how often quiet assets are reviewed by Gemini
COST_WATCH_INTERVAL_MIN=15
KPI_INSIGHT_TTL_MIN=60
BRIEFING_TTL_HOURS=4
AI_CHAT_RESERVE_PCT=40             # share of each model's daily quota kept for chat

# ── Rate limits (per minute) ─────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=10        # per IP
RATE_LIMIT_MESSAGES_PER_MIN=30     # per user

# ── Telemetry source ─────────────────────────────────────────────────────────
# The plant company and its data come from the telemetry source (../sara-simulator in development): it writes
# straight into MONGO_URI and INFLUX_URL above and has its own control panel (SIM_UI_PORT in its .env, default
# 5090). docker-compose --profile sim starts it next to SARA; its settings live in ../sara-simulator/.env.

# ── Web client (Vite reads only VITE_*) ──────────────────────────────────────
VITE_API_URL=                      # empty = same origin (/api is proxied to PORT in dev, by nginx in Docker)
